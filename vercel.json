{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "tanstack-start",
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": { "suf": ".vercel.app" }
        }
      ],
      "destination": "https://www.nesai.co.za/:path*",
      "permanent": true
    }
  ]
}
