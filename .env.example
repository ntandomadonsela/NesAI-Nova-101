# Public Supabase settings. These values are safe to expose to the browser.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Or use the Supabase anon/public key under this name.
VITE_SUPABASE_ANON_KEY=
VITE_APP_URL=https://your-production-domain.vercel.app

# Server-only Supabase settings.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# AI provider (server-only; never expose these through VITE_ variables)
# Free option: Groq API free tier. Account-wide limits apply; see current provider terms.
GROQ_API_KEY=
# Optional paid Gemini API key. Gemini unpaid tier has student data and age restrictions.
GEMINI_API_KEY=
# Optional OpenAI API key. Defaults to GPT-5.4 Mini when used directly.
OPENAI_API_KEY=
# Optional OpenAI-compatible gateway key; takes precedence over the direct provider keys.
AI_GATEWAY_API_KEY=
# If using AI_GATEWAY_API_KEY, defaults to OpenAI unless a compatible endpoint is specified.
AI_GATEWAY_BASE_URL=
# Optional model override; defaults to GPT-OSS 20B for GROQ_API_KEY, Gemini 3.8 Flash for GEMINI_API_KEY.
AI_GATEWAY_MODEL=

# PayPal. Only variables prefixed VITE_ are exposed to the browser.
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_PLAN_ID=
VITE_PAYPAL_CLIENT_ID=
VITE_PAYPAL_PLAN_ID=

# The website enquiry form posts to the Formspree endpoint configured in the server route.
