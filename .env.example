# Public Supabase settings. These values are safe to expose to the browser.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Or use the Supabase anon/public key under this name.
VITE_SUPABASE_ANON_KEY=
VITE_APP_URL=https://your-production-domain.vercel.app
# Mobile builds call the hosted API instead of the native WebView origin.
VITE_API_BASE_URL=https://www.nesai.co.za
VITE_IOS_PREMIUM_PRODUCT_ID=
VITE_ANDROID_PREMIUM_PRODUCT_ID=
VITE_ANDROID_PREMIUM_BASE_PLAN_ID=

# Server-only Supabase settings.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# AI provider (server-only)
AI_GATEWAY_API_KEY=
# Or use a Gemini API key directly; Gemini uses the Google OpenAI-compatible endpoint.
GEMINI_API_KEY=
# Or use this name for an OpenAI API key; AI_GATEWAY_API_KEY takes precedence if both are set.
OPENAI_API_KEY=
AI_GATEWAY_BASE_URL=
AI_GATEWAY_MODEL=

# PayPal. Only variables prefixed VITE_ are exposed to the browser.
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_PLAN_ID=
VITE_PAYPAL_CLIENT_ID=
VITE_PAYPAL_PLAN_ID=

# Native store subscriptions. Configure product IDs to match the store consoles.
IOS_PREMIUM_PRODUCT_ID=
ANDROID_PREMIUM_PRODUCT_ID=
ANDROID_PREMIUM_BASE_PLAN_ID=
ANDROID_PACKAGE_NAME=za.co.nesai.student
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=
GOOGLE_PUBSUB_AUDIENCE=https://www.nesai.co.za/api/payments/google-notifications
GOOGLE_PUBSUB_SERVICE_ACCOUNT_EMAIL=
IOS_BUNDLE_ID=za.co.nesai.student
APPLE_APP_ID=
# Comma-separated base64-encoded DER Apple root certificates used to verify StoreKit JWS.
APPLE_ROOT_CERTIFICATES_BASE64=
# Optional comma-separated overrides; defaults allow only Capacitor's local app origins.
MOBILE_APP_CORS_ORIGINS=

# Use Formspree for the website enquiry form, or keep a private CRM webhook as fallback.
FORMSPREE_FORM_ID=
LEADS_WEBHOOK_URL=
